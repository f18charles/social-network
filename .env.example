# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
# Port for the HTTP / WebSocket server (default: 8080)
PORT=8080

# Host address to bind to (e.g. localhost for local dev, 0.0.0.0 for Docker)
BASE_ADDRESS=0.0.0.0

# Runtime environment: "development" or "production"
# In "production":
#   - Cookies are set with Secure=true and SameSite=None (or configurable)
# In "development":
#   - Cookies are set with Secure=false and SameSite=Lax
APP_ENV=development

# Allowed Origins for CORS and WebSocket connection upgrades.
# Supports single origin, multiple comma-separated origins, or "*"
# In production, set to your frontend domain, e.g.:
# ALLOWED_ORIGIN=https://my-social-network.vercel.app,http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173

# SQLite database file path.
# - Local dev: ./backend/db.sqlite or ./db.sqlite
# - Docker: /app/data/db.sqlite
DATABASE_PATH=./backend/db.sqlite

# Migrations directory path.
# - Local dev: ./backend/internal/db/migrations or ./internal/db/migrations
# - Docker: /app/internal/db/migrations
MIGRATIONS_DIR=./backend/internal/db/migrations

# Optional cookie overrides:
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none

# ------------------------------------------------------------------------------
# Cloudinary Media Storage (Production / Optional for Dev)
# ------------------------------------------------------------------------------
# When set, user avatars, post images, and GIFs are uploaded directly to Cloudinary CDN.
# When unset or empty, the backend falls back to local filesystem storage in ./uploads.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
# In local development Vite dev server, target for proxying /api and /uploads
VITE_API_PROXY_TARGET=http://localhost:8080

# ── Vercel + Render deployment ─────────────────────────────────────────────────
# Set these in the Vercel dashboard (Project → Settings → Environment Variables).
# Replace <your-render-service> with your actual Render service subdomain.
#
# VITE_API_URL  – used by apiFetch() to prefix every /api/* request.
# VITE_WS_URL   – used by SocketProvider to open the WebSocket connection.
#
# VITE_API_URL=https://<your-render-service>.onrender.com
# VITE_WS_URL=wss://<your-render-service>.onrender.com/api/ws

