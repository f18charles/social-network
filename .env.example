PORT=8080
DATABASE_PATH=./backend/db.sqlite
BASE_ADDRESS=localhost
APP_ENV=development
ALLOWED_ORIGIN=http://localhost:5173
MIGRATIONS_DIR=./backend/internal/db/migrations
VITE_API_PROXY_TARGET=http://localhost:8080

# Optional. When set, uploaded post/comment/avatar images and GIFs are
# stored on Cloudinary instead of local disk. Format:
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
# Find these values in your Cloudinary dashboard under Account Details.
# Leave unset for local development to keep using ./uploads on disk.
CLOUDINARY_URL=
