# Backend Environment Variables

PORT=8080
BASE_ADDRESS=0.0.0.0
APP_ENV=development
ALLOWED_ORIGIN=http://localhost:5173
DATABASE_PATH=./db.sqlite
MIGRATIONS_DIR=./internal/db/migrations

# Optional Turso (remote libSQL) Database
# When both are set, the backend connects to Turso instead of local SQLite,
# and DATABASE_PATH is ignored. Required for deployments where local disk
# storage isn't persisted (e.g. Vercel serverless).
# Get these from: turso db show <db-name> --url
#                  turso db tokens create <db-name>
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=

# Optional Cloudinary Configuration
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Optional Cookie Overrides
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=lax
# In production (e.g. Vercel), typically:
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
